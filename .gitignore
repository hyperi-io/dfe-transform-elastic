# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor / IDE local state
.idea/
.vscode/

# Local environment files (never commit -- contain secrets)
.env
.env.local
.env.*.local
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml

# Build output
*.log
# Elastic fixture inputs are .log files and must survive the rule above.
!tests/fixtures/**/*.log
dist/
dist-bin/
build/
out/
test-results/
coverage/

# Rust build artefacts
target
target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
coverage-html/
coverage.lcov
tarpaulin-report.json
cobertura.xml

# cargo -- glob the contents, not the directory, so the negation applies.
.cargo/*
!.cargo/config.toml

# Elastic upstream test corpus -- large, fetched not committed
testdata/

# Python bytecode from the scripts/ tooling
__pycache__/
*.pyc

# Project temp directory
.tmp/

# Local working files (not committed)
docs/superpowers/
.claude/
.codex/
.cursor/
.gemini/
.cursorrules
hyperi-ai/
.mcp.json
.worktrees/
CLAUDE.md
STATE.md
TODO.md
AGENTS.md
GEMINI.md
.ai-version
