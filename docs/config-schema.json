{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "Top-level service configuration.",
  "type": "object",
  "properties": {
    "pipeline_name": {
      "description": "Name reported in metrics labels.",
      "type": "string",
      "default": "dfe-transform-elastic"
    },
    "source": {
      "description": "Inbound side.",
      "$ref": "#/$defs/SourceConfig"
    },
    "sink": {
      "description": "Outbound side.",
      "$ref": "#/$defs/SinkConfig"
    }
  },
  "required": [
    "source",
    "sink"
  ],
  "$defs": {
    "SourceConfig": {
      "description": "Inbound configuration.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Beats or Agent source whose transform to apply, e.g. `filebeat.okta`.",
          "type": "string"
        },
        "envelope": {
          "description": "Which transport delivered the payload. The transform is the same for\nall of them; only the unwrapping differs. Validation rejects an\nenvelope the source cannot actually arrive in.",
          "$ref": "#/$defs/Envelope",
          "default": "beats"
        },
        "topics": {
          "description": "Topics to consume.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "batch_size": {
          "description": "Events pulled per batch.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 20000
        },
        "group_id": {
          "description": "Kafka consumer group.",
          "type": "string"
        },
        "brokers": {
          "description": "Broker list.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "topics",
        "group_id",
        "brokers"
      ]
    },
    "Envelope": {
      "description": "How the payload is wrapped on the way in.",
      "oneOf": [
        {
          "description": "Beats or Elastic Agent: the raw vendor payload is a string in `message`.",
          "type": "string",
          "const": "beats"
        },
        {
          "description": "dfe-receiver syslog JSON: header parsed into siblings, body in\n`message`.",
          "type": "string",
          "const": "syslog"
        },
        {
          "description": "dfe-fetcher JSON: the provider's own payload at the top level, with the\nfetcher's delivery keys alongside it.",
          "type": "string",
          "const": "fetcher"
        }
      ]
    },
    "SinkConfig": {
      "description": "Outbound configuration.",
      "type": "object",
      "properties": {
        "topic": {
          "description": "Topic to produce to.",
          "type": "string"
        },
        "brokers": {
          "description": "Broker list. Defaults to the source brokers when unset.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "max_message_bytes": {
          "description": "Ceiling on one produced Kafka record. A batch is split into as many\nrecords as it takes to stay under it.\n\nMust sit below the LOWER of the broker's `message.max.bytes` and the\nproducer's -- raising the broker limit alone does nothing.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 900000
        }
      },
      "required": [
        "topic"
      ]
    }
  }
}
