# =============================================================================
# dfe-transform-elastic Environment (example)
# =============================================================================
# Copy to .env and fill in real values.
# Transform service is Kafka-only (no ClickHouse).

# =============================================================================
# Test Mode Selection
# =============================================================================
# "remote"  (default) — use the Kafka endpoint below
# "docker"            — use dfe-docker infra profile (localhost:19092, no auth)
TEST_MODE="remote"

# =============================================================================
# Kafka
# =============================================================================
KAFKA_BROKERS="kafka.example.com:9092"
KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_USER="dfe-transform-elastic"
KAFKA_SASL_PASSWORD="<password>"

# =============================================================================
# GeoIP Databases (optional — auto-detect from testdata/geoip/ if present)
# =============================================================================
# GEOIP_CITY_DB="testdata/geoip/dbip-city-lite.mmdb"
# GEOIP_ASN_DB="testdata/geoip/dbip-asn-lite.mmdb"

# =============================================================================
# DFE Transform Config (runtime — Phase 5)
# =============================================================================
# DFE_TRANSFORM_ELASTIC_MEMORY_LIMIT_BYTES="0"
# DFE_TRANSFORM_ELASTIC_MEMORY_PRESSURE_THRESHOLD="0.80"
# DFE_TRANSFORM_ELASTIC_MEMORY_CGROUP_HEADROOM="0.85"
